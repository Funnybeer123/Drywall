# Copy to .env.local for local dev. Every service is optional locally:
# anything left blank falls back to printing to the terminal instead of sending.

# Public URL of the site (used in emailed/texted links)
APP_URL=http://localhost:3000

# Time zone used for "today", due dates and the daily automation
BUSINESS_TIMEZONE=America/Chicago

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres (Neon). Leave blank locally to use the built-in embedded database in .data/
DATABASE_URL=

# Email (resend.com) — FROM must be on a domain you verified in Resend
RESEND_API_KEY=
EMAIL_FROM="Willy's Drywall <hello@yourdomain.com>"

# Text messages (twilio.com) — requires A2P 10DLC registration for business texting
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Online payments (stripe.com) — use sk_test_ keys until you go live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Photo & receipt storage (Vercel Blob). Leave blank locally to save into public/uploads
BLOB_READ_WRITE_TOKEN=

# Spam protection on the quote form (Cloudflare Turnstile). Optional.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects /api/cron/daily (Vercel sends this automatically as a Bearer token)
CRON_SECRET=change-me
